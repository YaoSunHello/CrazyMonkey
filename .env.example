# Copy to .env and fill in. NEVER commit .env — this repository is public.
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)

# --- The model -------------------------------------------------------------
# Any OpenAI-compatible /v1 endpoint. Tool calling is required: the agent
# terminates by calling submit_result, so a model that cannot emit a
# structured tool call cannot finish a run.
LLM_BASE_URL=https://your-vllm-host/v1
LLM_API_KEY=
# Leave blank to read the served id from GET /v1/models at startup rather than
# guessing it. Local ground truth beats a value pasted from somewhere else.
LLM_MODEL=

# Some endpoints sit behind a CDN that blocks the default Python user agent
# with a 403 — which looks exactly like an auth failure and poisons retries.
# Every request carries this header.
LLM_USER_AGENT=CrazyMonkey/0.1

# --- The sandbox -----------------------------------------------------------
# Where agent-written code runs. With no key set, execution falls back to a
# local subprocess, which has NO isolation and must be opted into explicitly
# with --allow-local-execution.
DAYTONA_API_KEY=
# Region. Without it the API rejects sandbox creation unless the organisation
# has a default region configured.
DAYTONA_TARGET=eu

# --- The loop --------------------------------------------------------------
# Attempts the agent gets to satisfy the verifier before the run is abandoned.
AGENT_MAX_ATTEMPTS=4
# Tool-call turns per attempt. Small quantised models routinely need more than
# 15 turns to land a terminal call; below that they get cut off mid-repair.
AGENT_MAX_TURNS=20
# Per-call HTTP deadline in seconds. Without one, LiteLLM falls back to 600s
# and a hung call stalls the whole run with nothing on screen.
AGENT_TIMEOUT=300

# --- Local browser/backend integration -------------------------------------
# Comma-separated exact origins. The defaults cover the supported Vite ports.
CRAZYMONKEY_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173

# --- RELAY immutable exports -----------------------------------------------
# Local directory for frozen review snapshots and generated PDF/XLSX/JSON/EML.
CRAZYMONKEY_RELAY_OUTPUT_DIR=outputs/relay

# Email is draft-only by default. Keep this false for the V0 demo.
CRAZYMONKEY_ENABLE_EMAIL_SEND=false
# Required only if real sending is explicitly enabled later.
CRAZYMONKEY_CONFIRMATION_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
