.DS_Store
__pycache__/
*.pyc
.venv/
venv/
node_modules/
product/
.env
outputs/*
!outputs/.gitkeep

# Working knowledge base — event material, credential notes, half-formed thinking
docs/

# The organisers have since committed the dataset themselves, under
# samples/01-bank-statements-to-journal-entries/, and these rules do not match it.
# They cover only the older flat drop-in some of us still have on disk, so an
# unpacked copy of the zip does not get committed a second time.
samples/statements/
samples/workbook/
samples/DATASET_README.md

# Each agent run stages a copy of the document it is about to parse next to the
# original, so the sandbox has one directory to upload. That lands inside the
# organisers' committed dataset folder, which is not ours to add files to.
.agent_data/

# Local working notes for Claude — not part of the deliverable.
CLAUDE.md

# Any .env variant, not just .env — a backup written beside it is still secrets.
.env
.env.*
*.env
!.env.example

# Local setup helpers may carry a key as a default argument.
setup_*.sh
backend/test-simple-frontend/dist/
