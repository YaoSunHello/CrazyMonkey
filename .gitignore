__pycache__/
*.pyc
.venv/
venv/
node_modules/
.env
outputs/*
!outputs/.gitkeep

# Working knowledge base — event material, credential notes, half-formed thinking
docs/

# Anonymised client data supplied by the organisers.
# Held out of the public repo until an organiser confirms it may be published:
# the pack's README says it is "safe to hand to contestants", which is not the
# same as safe to publish. See samples/README.md for the drop-in instructions.
samples/statements/
samples/workbook/
samples/DATASET_README.md

# Any .env variant, not just .env — a backup written beside it is still secrets.
.env
.env.*
*.env
!.env.example

# Local setup helpers may carry a key as a default argument.
setup_*.sh
