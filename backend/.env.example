# RELAY creates recipient-free .eml drafts by default. Real sending is opt-in.
CRAZYMONKEY_ENABLE_EMAIL_SEND=false
CRAZYMONKEY_CONFIRMATION_SECRET=
CRAZYMONKEY_RELAY_OUTPUT_DIR=
CRAZYMONKEY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
