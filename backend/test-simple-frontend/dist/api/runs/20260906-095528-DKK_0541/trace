{"kind": "code", "label": "/work/explore-2.py", "detail": "78 lines", "status": "ok", "body": "import kit\n\nprint(\"=== EXPLORING ROWS AND MATCHES ===\")\n\n# Pools for counterparty:\n# legal_entities:Legal Entity\n# related_parties:Related Party\n# vendors:Vendor\n# investors:Investor\n# deals_positions:Deal Name\n# deals_positions:Position\n\ncp_pools = [\n    ('legal_entities', 'Legal Entity'),\n    ('related_parties', 'Related Party'),\n    ('vendors', 'Vendor'),\n    ('investors', 'Investor'),\n    ('deals_positions', 'Deal Name'),\n    ('deals_positions', 'Position')\n]\n\nproj_pools = [\n    ('project_codes', 'Project Code'),\n    ('project_codes', 'New Project Code')\n]\n\n# Check account owner\nfor row in kit.rows():\n    print(f\"\\nRow {row['narrative']}:\")\n    print(f\"  trn_type: {row['trn_type']}\")\n    print(f\"  account: {row['account_number']}\")\n    \n    # Try looking up various substrings\n    narr = row['narrative']\n    parts = [p.strip() for p in narr.split(',')]\n    print(f\"  parts: {parts}\")\n    \n    for p in parts:\n        res = kit.lookup(p, cp_pools)\n        if res:\n            print(f\"    CP match for '{p}': {res}\")\n        else:\n            cands = kit.candidates(p, cp_pools, limit=3)\n            if cands:\n                print(f\"    CP cands for '{p}': {cands}\")\n                \n        pres = kit.lookup(p, proj_pools)\n        if pres:\n            print(f\"    Proj match for '{p}': {pres}\")\n        else:\n            pcands = kit.candidates(p, proj_pools, limit=3)\n            if pcands:\n                print(f\"    Proj cands for '{p}': {pcands}\")\n\nprint(\"\\n=== SEARCHING FOR SPECIFIC TOKENS ===\")\ntokens = ['NIP LIT', 'LIT', 'FREJA MOERCH', 'MOERCH', 'NORDVIK INFRASTRUCTURE PARTNER', 'NORDVIK']\nfor t in tokens:\n    res = kit.lookup(t, cp_pools)\n    print(f\"Lookup '{t}': {res}\")\n    cands = kit.candidates(t, cp_pools, limit=3)\n    print(f\"Candidates '{t}': {cands}\")\n    pres = kit.lookup(t, proj_pools)\n    print(f\"Lookup proj '{t}': {pres}\")\n    pcands = kit.candidates(t, proj_pools, limit=3)\n    print(f\"Candidates proj '{t}': {pcands}\")\n\n# Also search directly in tables\nprint(\"\\n=== SEARCH IN TABLES DIRECTLY ===\")\nfor tbl_name in ['vendors', 'related_parties', 'legal_entities', 'investors', 'deals_positions', 'project_codes']:\n    tbl = kit.table(tbl_name)\n    for col in tbl.columns:\n        vals = tbl.values(col)\n        for v in vals:\n            v_str = str(v)\n            if any(k in v_str.upper() for k in ['FREJA', 'MOERCH', 'LIT', 'NORDVIK INFRASTRUCTURE']):\n                print(f\"Found in {tbl_name}[{col}]: {v}\")\n\nprint(\"Exploration pass 2 completed.\")", "meta": {"preview_lines": 14}, "at": 1788685348.7537422}
