{"kind": "code", "label": "/work/explore-3.py", "detail": "68 lines", "status": "ok", "body": "import kit\n\nprint(\"=== ACCOUNT MAP ===\")\nt_acc = kit.table('account_map')\nfor row_idx in range(len(t_acc.values('Account Number'))):\n    acc = t_acc.values('Account Number')[row_idx]\n    bank_acc = t_acc.values('Bank Account')[row_idx]\n    print(f\"  {acc} -> {bank_acc}\")\n\nprint(\"\\n=== SEARCH ALL TABLES FOR NIP, NORDVIK, LIT, FREJA, MOERCH ===\")\nsearch_terms = ['FREJA', 'MOERCH', 'M\u00d8RCH', 'MORCH', 'LIT', 'NIP', 'NORDVIK', 'CALDER']\n\nfor tbl_name in kit.tables():\n    t = kit.table(tbl_name)\n    for col in t.columns:\n        vals = t.values(col)\n        for val in vals:\n            val_upper = str(val).upper()\n            for term in search_terms:\n                if term in val_upper:\n                    print(f\"[{tbl_name}][{col}] ({term}): {val}\")\n\nprint(\"\\n=== LOOKUP ALL SUBSTRINGS OF NARRATIVES ===\")\npools_cp = [\n    ('legal_entities', 'Legal Entity'),\n    ('related_parties', 'Related Party'),\n    ('vendors', 'Vendor'),\n    ('investors', 'Investor'),\n    ('deals_positions', 'Deal Name'),\n    ('deals_positions', 'Position'),\n]\n\npools_proj = [\n    ('project_codes', 'Project Code'),\n    ('project_codes', 'New Project Code'),\n]\n\nfor idx, r in enumerate(kit.rows()):\n    print(f\"\\n--- ROW {idx} ---\")\n    print(f\"narrative: {r['narrative']}\")\n    print(f\"trn_type: {r['trn_type']}, debit: {r.get('debit')}, credit: {r.get('credit')}\")\n    narrative = r['narrative']\n    words = narrative.replace(',', ' ').split()\n    # Try all contiguous spans of words (length 1 to 5)\n    for l in range(1, 6):\n        for i in range(len(words) - l + 1):\n            span = \" \".join(words[i:i+l])\n            # Strip slashes or punctuation\n            clean_span = span.strip('/.,-')\n            if clean_span:\n                res_cp = kit.lookup(clean_span, pools_cp)\n                if res_cp:\n                    print(f\"  CP MATCH for '{clean_span}' (from '{span}'): {res_cp}\")\n                res_pr = kit.lookup(clean_span, pools_proj)\n                if res_pr:\n                    print(f\"  PROJ MATCH for '{clean_span}' (from '{span}'): {res_pr}\")\n\nprint(\"\\n=== CANDIDATES FOR ROW STRINGS ===\")\nfor test_str in ['NIP LIT', 'LIT', 'FREJA MOERCH', 'NORDVIK INFRASTRUCTURE PARTNER', 'NORDVIK INFRASTRUCTURE PARTNERS', 'NIP']:\n    print(f\"\\nCandidates for '{test_str}':\")\n    c_cp = kit.candidates(test_str, pools_cp)\n    for c in c_cp:\n        print(f\"  CP: {c}\")\n    c_pr = kit.candidates(test_str, pools_proj)\n    for c in c_pr:\n        print(f\"  PR: {c}\")\n\nprint(\"Done exploration pass 3.\")", "meta": {"preview_lines": 14}, "at": 1788685360.0768497}
