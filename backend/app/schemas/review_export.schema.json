{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crazymonkey.local/schemas/review-export-v1.json",
  "title": "CrazyMonkey Review Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_metadata",
    "review_metadata",
    "summary",
    "coverage",
    "source_documents",
    "findings",
    "investor_terms",
    "calculations",
    "evidence_references",
    "challenger_concerns",
    "verifier_results",
    "human_review_decisions",
    "audit_trail",
    "unresolved_issues",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "crazymonkey-review-export-v1"},
    "export_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "version", "snapshot_sha256", "generated_at", "reporting_period", "mode", "mode_label"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "reporting_period": {"type": "string", "minLength": 1},
        "mode": {"enum": ["SYNTHETIC_DEMO", "LIVE"]},
        "mode_label": {"enum": ["Synthetic Demo", "Live"]}
      }
    },
    "review_metadata": {"type": "object"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks_completed", "matches", "discrepancies", "cannot_verify", "unsupported", "unreviewed"],
      "properties": {
        "checks_completed": {"type": "integer", "minimum": 0},
        "matches": {"type": "integer", "minimum": 0},
        "discrepancies": {"type": "integer", "minimum": 0},
        "cannot_verify": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "unreviewed": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {"type": "object"},
    "source_documents": {"type": "array", "items": {"type": "object"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "investor_id", "check_type", "computational_status", "human_review_status", "currency", "explanation", "evidence_ids"],
        "properties": {
          "finding_id": {"type": "string"},
          "investor_id": {"type": "string"},
          "check_type": {"type": "string"},
          "administrator_value": {"$ref": "#/$defs/exactDecimalOrNull"},
          "expected_value": {"$ref": "#/$defs/exactDecimalOrNull"},
          "difference": {"$ref": "#/$defs/exactDecimalOrNull"},
          "difference_convention": {"type": "string"},
          "variance_direction": {"type": "string"},
          "currency": {"type": "string"},
          "computational_status": {"enum": ["MATCH", "DISCREPANCY", "CANNOT_VERIFY", "UNSUPPORTED"]},
          "human_review_status": {"type": "string"},
          "explanation": {"type": "string"},
          "calculation_id": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "investor_terms": {"type": "array", "items": {"type": "object"}},
    "calculations": {"type": "array", "items": {"type": "object"}},
    "evidence_references": {"type": "array", "items": {"type": "object"}},
    "challenger_concerns": {"type": "array", "items": {"type": "object"}},
    "verifier_results": {"type": "array", "items": {"type": "object"}},
    "human_review_decisions": {"type": "array", "items": {"type": "object"}},
    "audit_trail": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "unresolved_issues": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "exactDecimalOrNull": {
      "oneOf": [
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        {"type": "null"}
      ]
    }
  }
}
